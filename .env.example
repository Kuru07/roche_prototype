# Groq LLM API (optional - system falls back to robust deterministic routing if not provided)
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# In-Memory FastEmbed Model (lightweight ONNX embeddings)
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5

# Demo Data Auto-Load (loads explicitly labeled [DEMO / SYNTHETIC] records on boot)
AUTO_LOAD_DEMO_DATA=true
