# ==============================================================================
# Roche Reference Pricing Intelligence Assistant — Environment Configuration
# ==============================================================================
# Copy this file to '.env' and adjust values as needed for your environment:
#   cp .env.example .env
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Groq LLM API Configuration (Optional)
# ------------------------------------------------------------------------------
# API Key for Groq cloud inference (obtain for free at https://console.groq.com).
# If omitted or left empty, the application automatically falls back to robust
# deterministic entity matching (RapidFuzz), deterministic SQL generation,
# and deterministic domain explanations for General Q&A.
GROQ_API_KEY=

# Model ID used for text-to-SQL generation and query intent routing.
# Default recommended: llama-3.3-70b-versatile
GROQ_MODEL=llama-3.3-70b-versatile

# Groq API request timeout in seconds.
GROQ_TIMEOUT=20.0

# ------------------------------------------------------------------------------
# 2. Embeddings & Vector Search (RAG)
# ------------------------------------------------------------------------------
# Model used for generating 384-dimensional dense semantic vectors for FAISS.
# Default: BAAI/bge-small-en-v1.5
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5

# Set to true to use ONNX-accelerated FastEmbed.
# Set to false to use the built-in resilient semantic embedder (pure NumPy, zero download).
USE_FASTEMBED=false

# ------------------------------------------------------------------------------
# 3. Demonstration & Synthetic Data Loading
# ------------------------------------------------------------------------------
# Whether to auto-seed labeled [DEMO / SYNTHETIC DATA] on startup.
# When true, loads baseline demo pricing and regulatory mock documents into DuckDB/FAISS.
# When false, starts with an empty volatile in-memory state.
AUTO_LOAD_DEMO_DATA=false
